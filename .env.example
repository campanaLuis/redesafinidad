# ── Frontend (build args – se hornean en el bundle) ─────────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJh...

# ── API PHP ──────────────────────────────────────────────────────────
APP_TOKEN_SECRET=cambia_esto_por_un_secreto_seguro

# ── Twilio (proxy de media) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx

# ── PostgreSQL para reportes (via Python) ────────────────────────────
REPORTES_PGHOST=tu-host-postgres
REPORTES_PGPORT=5432
REPORTES_PGUSER=tu_usuario
REPORTES_PGPASSWORD=tu_password
REPORTES_PGDATABASE=nombre_base_datos

# ── API interna de personas/territoriales/social-content ─────────────
# URL base del servicio en puerto 8089 (si corre como servicio separado en EasyPanel)
PERSONAS_API_URL=http://nombre-servicio:8089
